# ORACLE External Evidence Provider Environment Template
# Copy to .env and fill in your enterprise credentials

# GitHub Configuration
GITHUB_API_TOKEN=your_github_personal_access_token
GITHUB_BASE_URL=https://api.github.com
GITHUB_REPOS=owner/repo-1,owner/repo-2

# Jira Configuration
JIRA_API_TOKEN=your_atlassian_api_token
JIRA_EMAIL=your_email@domain.com
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECTS=PROJ1,PROJ2
