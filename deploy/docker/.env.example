# =============================================================================
# ORACLE Enterprise Runtime Environment Configuration Template (Brick 4.6)
# =============================================================================

# Deployment Environment: development | test | production
ORACLE_ENV=development

# Authoritative Persistence (PostgreSQL for enterprise; SQLite for local offline)
ORACLE_DB_BACKEND=postgres
ORACLE_DATABASE_URL=postgresql://oracle_user:oracle_secure_password@localhost:5432/oracle_db
ORACLE_DB_POOL_SIZE=10
ORACLE_DB_TIMEOUT=30.0

# Ephemeral Coordination (Redis is strictly non-authoritative)
ORACLE_REDIS_ENABLED=true
ORACLE_REDIS_URL=redis://localhost:6379/0
ORACLE_REDIS_FALLBACK=true

# Webhook & Network Ingress Security
ORACLE_WEBHOOK_SECRET=replace_with_cryptographically_secure_random_hex
ORACLE_WEBHOOK_MAX_DRIFT=300
ORACLE_WEBHOOK_MAX_PAYLOAD=1048576
ORACLE_REQUIRE_HTTPS=false

# Worker Node Execution
ORACLE_WORKER_CONCURRENCY=4
ORACLE_WORKER_LEASE_DURATION=30
ORACLE_WORKER_HEARTBEAT_INTERVAL=5.0

# Observability (Prometheus & OpenTelemetry)
ORACLE_PROMETHEUS_ENABLED=true
ORACLE_TRACING_ENABLED=true
ORACLE_OTEL_ENDPOINT=http://localhost:4318/v1/traces
ORACLE_TRACE_SAMPLE_RATE=1.0

# Multi-Tenancy
ORACLE_DEFAULT_TENANT=default
ORACLE_ENFORCE_MULTI_TENANCY=true
